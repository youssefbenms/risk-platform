# --- PostgreSQL ---
POSTGRES_USER=risk
POSTGRES_PASSWORD=test
POSTGRES_DB=riskdb
# Compte en lecture seule pour Power BI / Grafana (moindre privilège)
BI_READER_PASSWORD=test

# --- MongoDB ---
MONGO_USER=risk
MONGO_PASSWORD=test
MONGO_DB=riskdb

# --- URL utilisées quand tu lances le code depuis VS Code (hors Docker) ---
DATABASE_URL=postgresql+psycopg2://risk:test@localhost:5433/riskdb
MONGO_URL=mongodb://risk:test@localhost:27017/?authSource=admin

# --- Sources ---
STOOQ_APIKEY=
TICKERS=aapl.us,msft.us,jpm.us,gs.us
FX_CURRENCIES=USD,GBP,JPY,CHF
PRICE_START_DATE=2018-01-01

# --- API --- (génère une valeur longue : python -c "import secrets; print(secrets.token_urlsafe(32))")
API_KEY=

# --- Grafana / Airflow ---
GRAFANA_ADMIN_PASSWORD=test
AIRFLOW_ADMIN_PASSWORD=test