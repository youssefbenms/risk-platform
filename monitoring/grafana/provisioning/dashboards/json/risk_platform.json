{
  "uid": "risk-platform",
  "title": "Risk Platform – supervision",
  "schemaVersion": 39,
  "time": {
    "from": "now-1y",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "Europe/Paris",
  "tags": [
    "risk"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requêtes API par seconde",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (handler) (rate(http_requests_total[5m]))",
          "legendFormat": "{{handler}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latence p95 de l'API",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Erreurs 5xx par seconde",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{status=\"5xx\"}[5m])) or vector(0)",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "VaR historique 95 % à 1 jour, par actif",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "riskdb"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT r.metric_date::timestamp AS time, a.ticker AS metric, r.var_95_hist AS value\nFROM risk_metrics r JOIN dim_asset a ON a.asset_id = r.asset_id\nWHERE $__timeFilter(r.metric_date::timestamp)\nORDER BY 1"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Derniers contrôles qualité",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "riskdb"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT checked_at, dataset, check_name, passed, observed_value, threshold\nFROM data_quality_check ORDER BY checked_at DESC LIMIT 50"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Dernières exécutions du pipeline",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "riskdb"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT logged_at, run_id, step, status, rows_out, duration_s\nFROM etl_run_log ORDER BY logged_at DESC LIMIT 30"
        }
      ]
    }
  ]
}